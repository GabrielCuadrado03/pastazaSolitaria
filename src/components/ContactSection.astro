---
const whatsapp = import.meta.env.PUBLIC_CONTACT_WHATSAPP?.replace(/\D/g, '') ?? '593962803506';
const message = encodeURIComponent('Hola, quisiera colaborar con Unidos por la Esperanza.');
---
<section class="section wrap" id="contacto">
  <div class="contact-panel">
    <p class="eyebrow">Pastaza Solidaria</p>
    <h2>Hay muchas formas de ayudar.</h2>
    <p>Si representas a una empresa, fundación, institución o deseas contribuir con recursos, servicios o iniciativas solidarias, queremos escucharte.</p>
    {whatsapp ? <a class="contact-button" href={`https://wa.me/${whatsapp}?text=${message}`} target="_blank" rel="noopener noreferrer">Contactar por WhatsApp · +593 96 280 3506</a> : <p class="contact-pending">Canal de contacto próximamente disponible.</p>}
  </div>
</section>
<style>
.contact-panel{background:#f4e8f0;color:#241b3b;border-radius:24px;padding:clamp(1.5rem,5vw,3rem);text-align:center}
.contact-panel p{max-width:640px;margin:1rem auto}
.contact-button{display:inline-block;background:#a32777;color:white;border-radius:12px;padding:.9rem 1.4rem;text-decoration:none;font-weight:700}
.contact-pending{font-size:.9rem;color:#706c78}
</style>
