---
import { campaign } from '../data/campaign';
---
<section class="hero" id="inicio">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">Pastaza Solidaria · Ecuador</p>
      <h1>Unidos por <em>la Esperanza.</em></h1>
      <p class="hero-tagline">{campaign.subtitle}</p>
      <p class="hero-description">Una mañana cambió la vida de varias familias. Hoy podemos unirnos para acompañar a nuestros niños y apoyar su recuperación.</p>
      <div class="actions"><a class="button" href="#ninos">♡ Quiero ayudar</a><a class="button button-ghost" href="#historia">Conoce lo sucedido</a></div>
    </div>
    <div class="hero-art hero-photo"><img src="/images/portada.webp" alt="Ilustración conmemorativa de un niño con alas frente a las montañas y una aurora" fetchpriority="high" decoding="async" /></div>
  </div>
</section>
