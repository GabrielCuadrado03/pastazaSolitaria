---
import { events } from '../data/campaign';
---
<section class="section events" id="eventos">
  <div class="wrap">
    <div class="section-heading"><p class="eyebrow">Una comunidad que se une</p><h2>Eventos solidarios.</h2><p>Conoce las iniciativas de nuestra comunidad para apoyar a las familias. Consulta con cada organizador la disponibilidad de su actividad.</p></div>
    <div class="events-grid">
      {events.map(event => <article class="event-card event-poster-card">
        <a class="event-poster" href={event.image} target="_blank" rel="noopener noreferrer" aria-label={'Ampliar afiche de ' + event.title}><img src={event.image} alt={'Afiche de ' + event.title + ' · ' + event.organizer} loading="lazy" decoding="async" /></a>
        <div class="event-body"><p class="eyebrow">{event.status}</p><h3>{event.title}</h3><p class="event-organizer">{event.organizer}</p><p>{event.description}</p><p class="event-location"><strong>Lugar:</strong> {event.location}</p>{event.contactUrl && <a class="button" href={event.contactUrl} target="_blank" rel="noopener noreferrer">{event.contactLabel}</a>}</div>
      </article>)}
    </div>
  </div>
</section>
